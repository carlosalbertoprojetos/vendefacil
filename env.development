# ===================================================
# VENDASIMPLES - CONFIGURAÇÕES DE DESENVOLVIMENTO
# ===================================================

# Django Settings
SECRET_KEY=django-insecure-vendasimples-dev-2024-super-secret-key-for-development-only
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database - PostgreSQL
DB_NAME=vendasimples_dev
DB_USER=admin
DB_PASSWORD=admin123
DB_HOST=localhost
DB_PORT=5432

# Redis Cache & Sessions
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_CACHE_URL=redis://127.0.0.1:6379/2

# Celery Task Queue
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Email Configuration (Development - Console Backend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=vendasimples@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=noreply@vendasimples.com.br
SERVER_EMAIL=admin@vendasimples.com.br

# AWS S3 Storage (Disabled for Development)
USE_S3=False
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=vendasimples-dev
AWS_S3_REGION_NAME=us-east-1

# Admin Configuration
ADMIN_EMAIL=admin@vendasimples.com.br
ADMINS=Admin,admin@vendasimples.com.br

# CORS Settings (Development)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=True

# Security Settings (Development - Relaxed)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Logging (Development)
LOG_LEVEL=DEBUG
LOG_FILE=logs/django.log

# File Upload Limits
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
MAX_FILE_SIZE=10485760

# Cache Settings
CACHE_TTL=60
SESSION_CACHE_ALIAS=default

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Cart Configuration
CART_SESSION_ID=vendasimples_cart
CART_SESSION_EXPIRE=86400

# Product Configuration
PRODUCT_IMAGE_MAX_SIZE=5242880
PRODUCT_IMAGE_ALLOWED_FORMATS=jpg,jpeg,png,gif,webp
PRODUCT_THUMBNAIL_SIZE=300,300

# Order Configuration (Development)
ORDER_NUMBER_PREFIX=DEV
ORDER_AUTO_CONFIRM=True
ORDER_CANCELLATION_HOURS=24

# Notification Configuration (Development)
NOTIFICATION_EMAIL_ENABLED=True
NOTIFICATION_SMS_ENABLED=False
NOTIFICATION_WHATSAPP_ENABLED=True
NOTIFICATION_PUSH_ENABLED=False

# Company Configuration
COMPANY_LOGO_MAX_SIZE=2097152
COMPANY_BANNER_MAX_SIZE=5242880
COMPANY_THEME_DEFAULT_PRIMARY=#2563eb
COMPANY_THEME_DEFAULT_SECUNDARIA=#64748b

# Development Specific
DJANGO_SETTINGS_MODULE=config.settings.development
